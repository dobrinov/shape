lanes release: From idea to brew upgrade {
  lane owner: Owner {
    ask: Ask for a feature [pill, green]
    push: Say “push it”
  }
  lane agent: Claude Code {
    build: Build and test
    check: Tests pass? [diamond]
    tag: Changelog and tag
  }
  lane ci: GitHub Actions [blue] {
    binaries: Build binaries
    tap: Update Homebrew
  }
}
ask -> build -> check
check -> tag: yes
check -> build: no
tag -> push -> binaries -> tap
