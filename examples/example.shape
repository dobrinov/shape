canvas screens: Shape's screens {
  screen board: Editor [web] {
    navbar: shape | Full board | History | Present | Share
    sidebar: Select | Box | Sticky | Connect | Comment
    title: roadmap.shape
    image: The board
    badges: Saved | 100%
    fab: ✦
  }
  screen pick: Pick a perspective [web] {
    header: Open as…
    radio: Full board | Product | Technical | Users
    text: You can switch any time from the top bar.
    button open: Open [blue]
  }
  screen ask: ✦ Ask [web] {
    header: Ask the AI
    tabs: Ask | Add | Rethink
    textarea: What blocks the launch?
    button send: Ask [blue]
    alert: Uses Claude Code, signed in as you
  }
  screen viewer: Board viewer (idea) [mobile] {
    header: Shape
    search: Find on the board
    list: Discovery | Roadmap | Data & flows | Metrics
    button view: Present [green]
    tabbar: Boards | Recent | Me
  }

  board -> pick: opens with
  pick.open -> board: shows
  board -> ask: ✦
  ask.send -> board: answers on
  viewer -> board: same file
}
