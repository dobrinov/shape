{
  "name": "@dobrinov/shape",
  "version": "0.57.0",
  "private": true,
  "description": "FigJam-style boards as text (mindmaps, flowcharts, swimlanes, gantt charts, review comments) with ops and prompts for LLMs. WASM, for Node and browsers.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./shape_wasm_bg.wasm": "./pkg/shape_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "pkg/shape_wasm.js",
    "pkg/shape_wasm_bg.wasm",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": ["shape", "diagram", "mindmap", "flowchart", "gantt", "swimlanes", "figjam", "llm", "wasm"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dobrinov/shape.git",
    "directory": "js"
  }
}
